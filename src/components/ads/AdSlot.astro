---
import { t, type Lang } from '../../i18n/utils';
import type { AdSlotId } from '../../data/ads';

/**
 * One labeled ad position. Six of these exist on every page:
 *
 *   banner  ×3 — in the page flow (top, middle, bottom)
 *   rail    ×2 — fixed to the left and right gutters while the page scrolls
 *   anchor  ×1 — fixed above the bottom edge, collapsible
 *
 * Two policies are encoded in the markup rather than in someone's memory:
 * the slot reserves its own height (so filling it cannot shift the layout), and
 * it is labelled before any ad exists — AdSense allows only "Advertisement" or
 * "Sponsored links" as a label, and an unlabelled slot is a policy problem even
 * when it is empty.
 *
 * Nothing is requested until lib/ads/client.ts decides it may be: see consent.ts
 * for why a declined visitor in the EEA gets no request at all while a declined
 * visitor elsewhere gets a non-personalized one.
 */
interface Props {
  lang: Lang;
  variant: 'banner' | 'rail' | 'anchor';
  id: AdSlotId;
}

import { ADS, type AdSlotId } from '../../data/ads';
const { lang, variant, id } = Astro.props;
const label = t(lang, 'ad.label');
/*
 * Auto ads (option B): the site script alone serves the ads, Google picks the
 * placements, and a slot with no unit id has nothing of its own to show. Rendering
 * it would leave a labeled empty box and - for the bottom slot - a bar with
 * nothing in it, so it renders disabled instead. Fill ADS.slots[id] and every
 * position comes straight back.
 */
const unit = ADS.slots[id as AdSlotId] ?? '';
const showSlot = ADS.client.length > 0 && unit.length > 0;
---

<aside
  class={`ad-slot ad-slot-${variant}`}
  data-ad-id={id}
  data-disabled={showSlot ? undefined : '1'}
  style={showSlot ? undefined : 'display:none'}
  data-ad-variant={variant}
  data-collapsed="0"
  role="complementary"
  aria-label={label}
>
  <div class="ad-head">
    <p class="ad-label">{label}</p>
    {
      variant === 'rail' && (
        <button
          class="ad-close"
          type="button"
          data-ad-close
          aria-label={t(lang, 'ad.closeAd')}
          title={t(lang, 'ad.closeAd')}
        >
          ×
        </button>
      )
    }
    {
      variant === 'anchor' && (
        <button
          class="ad-collapse"
          type="button"
          data-ad-collapse
          aria-expanded="true"
          aria-label={`${t(lang, 'ad.collapse')} / ${t(lang, 'ad.expand')}`}
          title={`${t(lang, 'ad.collapse')} / ${t(lang, 'ad.expand')}`}
          data-label-hide="▼"
          data-label-show="▲"
        >
          ▼
        </button>
      )
    }
  </div>
  <div class="ad-body" data-ad-body>
    <p class="ad-note">{t(lang, 'ad.pending')}</p>
  </div>
</aside>

{
  variant === 'anchor' && <div class="ad-anchor-spacer" data-ad-spacer aria-hidden="true" />
}

<script>
  import { bootAds } from '../../lib/ads/client';
  bootAds();
</script>

<style>
  .ad-slot {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fbfcfe;
    overflow: hidden;
  }
  .ad-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 6px 10px;
  }
  .ad-label,
  .ad-note {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .ad-note {
    text-transform: none;
    letter-spacing: 0;
    color: var(--muted-2);
  }
  .ad-body {
    display: grid;
    place-items: center;
    min-height: 90px;
    padding: 10px;
    text-align: center;
  }
  .ad-collapse {
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    font-size: 11px;
    color: var(--muted);
    cursor: pointer;
  }
  .ad-collapse:hover {
    color: var(--ink-2);
  }

  /* ---- in-page banners ---- */
  .ad-slot-banner {
    margin: 34px 0;
  }

  /* ---- side rails: only where the gutters can hold them ---- */
  .ad-slot-rail {
    display: none;
    position: fixed;
    top: 132px;
    width: 150px;
    z-index: 20;
  }
  .ad-slot-rail .ad-body {
    min-height: 420px;
  }
  .ad-slot-rail[data-ad-id='rail-left'] {
    left: 12px;
  }
  .ad-slot-rail[data-ad-id='rail-right'] {
    right: 12px;
  }
  @media (min-width: 1500px) {
    .ad-slot-rail {
      display: block;
    }
  }
  /* Closed for this page view only. `[hidden]` would lose to the media query
     above, so the state is carried by an attribute with its own rule. */
  .ad-slot-rail[data-closed='1'] {
    display: none;
  }
  .ad-close {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--muted-2);
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
  }
  .ad-close:hover {
    background: #eef2f8;
    color: var(--ink);
  }

  /* ---- collapsible anchor above the bottom edge ---- */
  .ad-slot-anchor {
    position: fixed;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: min(970px, calc(100vw - 24px));
    border-radius: 12px 12px 0 0;
    border-bottom: 0;
    background: #fff;
    box-shadow: var(--sh-2, 0 -6px 24px rgba(10, 23, 48, .12));
    z-index: 30;
  }
  .ad-slot-anchor .ad-body {
    min-height: 60px;
  }
  .ad-slot-anchor[data-collapsed='1'] .ad-body {
    display: none;
  }

  /*
   * Collapsed, the whole slot shrinks to a single arrow in the corner. Hiding
   * only the ad body left the label row behind, and that row still covered the
   * last line of the page — the complaint this fixes. The spacer shrinks with it
   * so the arrow sits in its own band instead of over the footer.
   */
  .ad-slot-anchor[data-collapsed='1'] {
    left: auto;
    right: 14px;
    transform: none;
    width: auto;
    background: transparent;
    border: 0;
    box-shadow: none;
  }
  .ad-slot-anchor[data-collapsed='1'] .ad-head {
    height: 38px;
    padding: 0;
    justify-content: flex-end;
  }
  /* Explicit box: without it the slot kept the height of its hidden body. */
  .ad-slot-anchor[data-collapsed='1'] {
    height: 38px;
    overflow: visible;
  }
  .ad-slot-anchor[data-collapsed='1'] .ad-label {
    display: none;
  }
  .ad-slot-anchor[data-collapsed='1'] .ad-collapse {
    display: grid;
    place-items: center;
  }
  .ad-anchor-spacer {
    height: 148px;
  }
  .ad-anchor-spacer[data-collapsed='1'] {
    height: 46px;
  }
  .ad-anchor-spacer[hidden] {
    display: none;
  }

  /*
   * Phones get neither the side rails (they already needed a 1500px gutter) nor
   * the bottom slot: a fixed band plus an in-flow banner eats the screen that the
   * content needs, and Google's own density rule measures mobile separately.
   */
  @media (max-width: 760px) {
    .ad-slot-anchor,
    .ad-anchor-spacer {
      display: none;
    }
  }

  /*
   * Short viewports - a landscape phone, a small laptop window - are where a
   * fixed bottom band stops being a band and starts being a third of the screen:
   * 127px of anchor against a 400px viewport trips Chrome's large-sticky-ad rule
   * for mobile. Hiding it there costs one placement and removes the risk of the
   * whole ad load being blocked. Not clipped, not shrunk: hidden, so no creative
   * is ever truncated.
   */
  @media (max-height: 560px) {
    .ad-slot-anchor,
    .ad-anchor-spacer {
      display: none;
    }
  }

</style>
