---
interface Props {
  data: Record<string, unknown> | Record<string, unknown>[];
}

const { data } = Astro.props;

/** Merge several schema objects into a single @graph so the entities stay linked. */
const payload = Array.isArray(data)
  ? {
      '@context': 'https://schema.org',
      '@graph': data.map((entry) => {
        const { ['@context']: _ctx, ...rest } = entry as Record<string, unknown>;
        return rest;
      }),
    }
  : data;
---

<script type="application/ld+json" set:html={JSON.stringify(payload)} />
