---
import { home } from '../../data/home';
import type { Lang } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = home[lang].trust;
---

<section class="section">
  <div class="wrap">
    <p class="eyebrow">{c.eyebrow}</p>
    <h2 class="h2" style="margin-top:12px">{c.heading}</h2>
    <div class="tc">
      <div class="tc-h">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 2.6 4.6 5.3v6c0 4.6 3.1 8.8 7.4 10.1 4.3-1.3 7.4-5.5 7.4-10.1v-6L12 2.6Z" stroke="#2f6bed" stroke-width="1.6"></path>
        </svg>
        <h3>{c.title}</h3>
        <span class="tag">{c.tag}</span>
      </div>
      <div class="tc-g">
        {
          c.points.map((point) => (
            <div class="tc-i">
              <h4>
                <span class="num">{point.num}</span>
                {point.title}
              </h4>
              <p>{point.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .tc {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 34px;
    margin-top: 38px;
    box-shadow: var(--sh-1);
  }
  .tc-h {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    border-bottom: 1px solid var(--line);
    padding-bottom: 20px;
    margin-bottom: 24px;
  }
  .tc-h h3 {
    font-size: 19px;
  }
  .tag {
    margin-left: auto;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--green);
    background: var(--green-soft);
    border-radius: 999px;
    padding: 6px 13px;
  }
  .tc-g {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px;
  }
  .tc-i h4 {
    font-size: 14.5px;
    margin-bottom: 8px;
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }
  .num {
    color: var(--blue);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .tc-i p {
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.68;
  }
  @media (max-width: 960px) {
    .tc-g {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .tc {
      padding: 24px 20px;
    }
    .tc-g {
      grid-template-columns: 1fr;
    }
  }
</style>
