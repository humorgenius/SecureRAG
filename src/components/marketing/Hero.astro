---
import { home } from '../../data/home';
import { t, localizePath, type Lang } from '../../i18n/utils';
import PrivacyBadge from './PrivacyBadge.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = home[lang].hero;
const p = c.preview;
---

<section class="hero">
  <div class="glow g1"></div>
  <div class="glow g2"></div>
  <div class="grid" aria-hidden="true"></div>

  <div class="wrap hero-in">
    <span class="badge anim-in d1">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 2.6 4.6 5.3v6c0 4.6 3.1 8.8 7.4 10.1 4.3-1.3 7.4-5.5 7.4-10.1v-6L12 2.6Z" stroke="#8ab4ff" stroke-width="1.8"></path>
      </svg>
      {c.badge}
    </span>

    <h1 class="h1 anim-in d2">
      {c.h1a}<span class="accent">{c.h1accent}</span>{c.h1b}
    </h1>

    <p class="lede anim-in d3">{c.lede}</p>

    <div class="ctas anim-in d4">
      <a class="btn btn-blue btn-lg" href={localizePath(lang, '/app/')}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M12 15V4m0 0L8 8m4-4 4 4M5 17v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        {c.ctaPrimary}
      </a>
      <a class="btn btn-ghost-d btn-lg" href={localizePath(lang, '/security/')}>{c.ctaSecondary}</a>
    </div>

    <div class="promise-row anim-in d5">
      <PrivacyBadge lang={lang} variant="dark" />
    </div>

    <!-- Product preview: a static illustration of the workspace (no data, no scripts). -->
    <div class="herocard anim-in d5" role="img" aria-label={`${t(lang, 'nav.app')} — SecureRAG workspace`}>
      <div class="hc-top">
        <span class="mono url">{p.url}</span>
        <span class="live">● {p.live}</span>
      </div>
      <div class="hc-body">
        <div class="hc-left">
          <h4>{p.docsTitle}</h4>
          {
            p.docs.map((d) => (
              <div class="doc">
                <span class={`ft ${d.kind}`}>{d.tag}</span>
                <span class="dm2">
                  <b>{d.name}</b>
                  <span>{d.meta}</span>
                </span>
              </div>
            ))
          }
          <h4 class="mt">{p.indexTitle}</h4>
          {
            p.indexRows.map((row) => (
              <div class="doc">
                <span class="ft dim">{row.tag}</span>
                <span class="dm2">
                  <b class="muted">{row.title}</b>
                  <span>{row.meta}</span>
                </span>
              </div>
            ))
          }
        </div>
        <div class="hc-right">
          <div class="q2">{p.question}</div>
          <div class="a2">
            <div class="who">● {p.answerLabel}</div>
            <p>
              {p.answer.a}<strong>{p.answer.strong}</strong>{p.answer.b}<span class="cite">{p.answer.c1}</span>{p.answer.mid}<span
                class="cite">{p.answer.c2}</span>
            </p>
            <div class="srcline">
              <div class="sh">{p.sourceLabel}</div>
              <div class="sb">{p.source.pre}<mark>{p.source.mark}</mark>{p.source.post}</div>
            </div>
            <div class="hc-foot">
              <span class="ph2">{p.placeholder}</span>
              <span class="btn btn-blue">{p.send}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: linear-gradient(180deg, #081228 0%, #0d1e40 100%);
    color: rgba(255, 255, 255, .72);
    overflow: hidden;
    padding: 74px 0 0;
    font-size: 16px;
  }
  .glow {
    position: absolute;
    pointer-events: none;
  }
  .g1 {
    width: 760px;
    height: 520px;
    left: -120px;
    top: -220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(47, 107, 237, .42), transparent 66%);
    filter: blur(20px);
  }
  .g2 {
    width: 620px;
    height: 480px;
    right: -140px;
    top: -120px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(122, 165, 255, .24), transparent 68%);
    filter: blur(14px);
  }
  .grid {
    position: absolute;
    inset: 0;
    opacity: .5;
    background-image: linear-gradient(rgba(255, 255, 255, .05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .05) 1px, transparent 1px);
    background-size: 58px 58px;
    mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, .25) 60%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, .25) 60%, transparent 100%);
  }
  .hero-in {
    position: relative;
    padding-bottom: 118px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 12.5px;
    font-weight: 600;
    color: #cfe0ff;
    border: 1px solid rgba(122, 165, 255, .34);
    background: rgba(47, 107, 237, .16);
    border-radius: 999px;
    padding: 6px 14px;
  }
  .h1 {
    color: #fff;
    margin: 22px 0 0;
  }
  .accent {
    color: #8ab4ff;
  }
  .lede {
    margin-top: 20px;
    color: rgba(255, 255, 255, .7);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
    align-items: center;
  }
  .promise-row {
    margin-top: 34px;
    padding-top: 26px;
    border-top: 1px solid rgba(255, 255, 255, .12);
  }

  /* preview card */
  .herocard {
    margin-top: 44px;
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 40px 80px -40px rgba(3, 10, 28, .75);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .hc-top {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 13px 18px;
    border-bottom: 1px solid var(--line);
    background: #fbfcfe;
  }
  .url {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--muted);
  }
  .live {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: .04em;
    color: var(--green);
    background: var(--green-soft);
    border-radius: 999px;
    padding: 4px 11px;
  }
  .hc-body {
    display: grid;
    grid-template-columns: 288px 1fr;
  }
  .hc-left {
    border-right: 1px solid var(--line);
    padding: 18px 16px;
    background: #fbfcfe;
  }
  .hc-left h4 {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin-bottom: 12px;
  }
  .hc-left h4.mt {
    margin-top: 20px;
  }
  .doc {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 10px;
    border-radius: 10px;
    border: 1px solid transparent;
  }
  .doc:first-of-type {
    background: #fff;
    border-color: var(--line);
    box-shadow: var(--sh-1);
  }
  .ft {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    font-size: 9.5px;
    font-weight: 700;
    font-family: var(--font-mono);
  }
  .ft.pdf {
    background: #fdecea;
    color: var(--red);
  }
  .ft.docx {
    background: var(--blue-soft);
    color: var(--blue-d);
  }
  .ft.md {
    background: var(--green-soft);
    color: var(--green);
  }
  .ft.dim {
    background: #f2f4f8;
    color: var(--muted);
  }
  .dm2 {
    min-width: 0;
  }
  .dm2 b {
    display: block;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dm2 b.muted {
    color: var(--muted);
  }
  .dm2 span {
    font-size: 11.5px;
    color: var(--muted-2);
  }
  .hc-right {
    padding: 20px 22px;
  }
  .q2 {
    background: var(--blue-soft);
    border: 1px solid #d8e4fb;
    border-radius: 12px;
    padding: 11px 14px;
    font-size: 14px;
    color: var(--ink);
    margin-left: auto;
    max-width: 80%;
  }
  .a2 {
    margin-top: 16px;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin-bottom: 9px;
  }
  .a2 p {
    font-size: 14.5px;
    line-height: 1.68;
    color: var(--ink-2);
  }
  .a2 strong {
    color: var(--ink);
  }
  .cite {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10.5px;
    vertical-align: super;
    color: var(--blue-d);
    background: var(--blue-soft);
    border: 1px solid #cfdcf9;
    border-radius: 4px;
    padding: 1px 5px;
    margin-left: 3px;
  }
  .srcline {
    margin-top: 13px;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .sh {
    padding: 9px 12px;
    background: #fbfcfe;
    border-bottom: 1px solid var(--line);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--muted);
    font-family: var(--font-mono);
  }
  .sb {
    padding: 11px 12px;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.62;
  }
  .sb mark {
    background: #fff2c9;
    color: var(--ink);
    border-radius: 3px;
    padding: 0 2px;
  }
  .hc-foot {
    margin-top: 16px;
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .ph2 {
    flex: 1;
    border: 1px solid var(--line);
    border-radius: 9px;
    padding: 10px 13px;
    font-size: 13.5px;
    color: var(--muted-2);
    background: #fbfcfe;
  }
  @media (max-width: 880px) {
    .hc-body {
      grid-template-columns: 1fr;
    }
    .hc-left {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: 54px;
    }
    .hero-in {
      padding-bottom: 74px;
    }
  }
</style>
