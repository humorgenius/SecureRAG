---
import AdSlotUnit from '../ads/AdSlot.astro';

/**
 * In-page banner, at the position each page already used for its ad slot.
 *
 * Kept as a wrapper so the pages that call it did not have to change; the actual
 * slot (variants, consent handling, reserved height) lives in components/ads.
 * Every page also gets a top and a bottom banner, two side rails and a
 * collapsible anchor from BaseLayout.
 */
interface Props {
  lang: Lang;
}
import type { Lang } from '../../i18n/utils';

const { lang } = Astro.props;
---

<AdSlotUnit lang={lang} variant="banner" id="banner-mid" />
