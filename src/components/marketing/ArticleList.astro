---
import { localizePath, t, type Lang } from '../../i18n/utils';

interface Item {
  href: string;
  title: string;
  description: string;
  minutes: number;
  date: string;
}

interface Props {
  lang: Lang;
  items: Item[];
}

const { lang, items } = Astro.props;
---

<ul class="alist">
  {
    items.map((item) => (
      <li>
        <a class="acard" href={item.href}>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <span class="meta">
            <time datetime={item.date}>{item.date}</time> · {item.minutes} {t(lang, 'common.minutes')}
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .alist {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 34px;
  }
  .acard {
    display: block;
    height: 100%;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 24px 24px 22px;
    box-shadow: var(--sh-1);
    transition: transform .2s, box-shadow .2s, border-color .2s;
  }
  .acard:hover {
    transform: translateY(-3px);
    box-shadow: var(--sh-2);
    border-color: var(--line-2);
  }
  .acard h3 {
    font-size: 17px;
    margin-bottom: 9px;
    letter-spacing: -.015em;
  }
  .acard p {
    font-size: 14.5px;
    color: var(--muted);
    line-height: 1.68;
  }
  .meta {
    display: block;
    margin-top: 14px;
    font-size: 12.5px;
    color: var(--muted-2);
    font-family: var(--font-mono);
  }
  @media (max-width: 760px) {
    .alist {
      grid-template-columns: 1fr;
    }
  }
</style>
