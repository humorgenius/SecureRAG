---
import { altLangPath } from '../../lib/i18n/route';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
  /** locale-prefixed current path, e.g. '/zh/guides/x/' */
  path: string;
}

const { lang, path } = Astro.props;
const other: Lang = lang === 'en' ? 'zh' : 'en';
/** Map the *current page* onto the other locale — never fall back to the homepage. */
const otherHref = altLangPath(path, other);
---

<div class="langsw" role="group" aria-label="Language">
  <a href={path} class={lang === 'en' ? 'on' : ''} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
  <a href={otherHref} class={lang === 'zh' ? 'on' : ''} aria-current={lang === 'zh' ? 'true' : undefined}>中文</a>
</div>

<style>
  .langsw {
    display: flex;
    border: 1px solid rgba(255, 255, 255, .2);
    border-radius: 999px;
    overflow: hidden;
  }
  .langsw a {
    padding: 5px 12px;
    font-size: 12.5px;
    font-weight: 600;
    color: rgba(255, 255, 255, .6);
    transition: background .15s, color .15s;
  }
  .langsw a:hover { color: #fff; }
  .langsw a.on { background: rgba(255, 255, 255, .14); color: #fff; }
</style>
