---
import { t, type Lang } from '../../i18n/utils';

/**
 * Back-to-top control, bottom right on every page.
 *
 * Only shown once the reader has actually scrolled — at the top of a page it
 * would be a button that does nothing. The anchor slot owns the bottom centre
 * and spans nearly the full width on small screens, so below 1100px the button
 * sits above that band instead of on top of it.
 */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<button class="to-top" type="button" data-to-top hidden aria-label={t(lang, 'a11y.top')} title={t(lang, 'a11y.top')}>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M12 19V5m0 0-6 6m6-6 6 6"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-to-top]');
  if (button) {
    const sync = () => {
      button.hidden = window.scrollY < 400;
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });

    button.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>

<style>
  .to-top {
    position: fixed;
    right: 20px;
    bottom: 24px;
    z-index: 35;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    box-shadow: 0 8px 22px rgba(10, 23, 48, .16);
    cursor: pointer;
  }
  .to-top[hidden] {
    display: none;
  }
  .to-top:hover {
    border-color: var(--blue);
    color: var(--blue-d);
  }
  @media (max-width: 1100px) {
    .to-top {
      bottom: 160px;
    }
  }
</style>
