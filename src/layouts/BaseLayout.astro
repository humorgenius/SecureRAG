---
import BaseHead from '../components/seo/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import AdSlotUnit from '../components/ads/AdSlot.astro';
import ConsentGate from '../components/ads/ConsentGate.astro';
import '../styles/global.css';
import type { Lang } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** locale-prefixed, trailing-slash path */
  path: string;
  type?: string;
  image?: string;
  noindex?: boolean;
  activeNav?: string;
  /** the homepage opens with its own hero, so it carries no top banner */
  noTopAd?: boolean;
}

const { title, description, lang, path, type, image, noindex, activeNav, noTopAd = false } = Astro.props;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hans' : 'en'}>
  <head>
    <BaseHead title={title} description={description} lang={lang} path={path} type={type} image={image} noindex={noindex} />
    <slot name="head" />
  </head>
  <body>
    <SkipLink lang={lang} />
    <Header lang={lang} path={path} activeNav={activeNav} />
    {/* Two side rails: fixed to the gutters, and only shown where the gutter can
        hold them (see the 1500px breakpoint in AdSlot.astro). */}
    <AdSlotUnit lang={lang} variant="rail" id="rail-left" />
    <AdSlotUnit lang={lang} variant="rail" id="rail-right" />

    <main id="main">
      {!noTopAd && (
        <div class="wrap">
          <AdSlotUnit lang={lang} variant="banner" id="banner-top" />
        </div>
      )}
      <slot />
      <div class="wrap">
        <AdSlotUnit lang={lang} variant="banner" id="banner-bottom" />
      </div>
    </main>

    <Footer lang={lang} />
    <AdSlotUnit lang={lang} variant="anchor" id="anchor" />
    <ConsentGate lang={lang} />
    <slot name="foot" />
  </body>
</html>
