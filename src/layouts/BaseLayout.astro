---
import BaseHead from '../components/seo/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import '../styles/global.css';
import type { Lang } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** locale-prefixed, trailing-slash path */
  path: string;
  type?: string;
  image?: string;
  noindex?: boolean;
  activeNav?: string;
}

const { title, description, lang, path, type, image, noindex, activeNav } = Astro.props;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hans' : 'en'}>
  <head>
    <BaseHead title={title} description={description} lang={lang} path={path} type={type} image={image} noindex={noindex} />
    <slot name="head" />
  </head>
  <body>
    <SkipLink lang={lang} />
    <Header lang={lang} path={path} activeNav={activeNav} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <slot name="foot" />
  </body>
</html>
