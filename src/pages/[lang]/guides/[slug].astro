---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/seo/Breadcrumbs.astro';
import AdSlot from '../../../components/marketing/AdSlot.astro';
import JsonLd from '../../../components/seo/JsonLd.astro';
import { t, localizePath, type Lang } from '../../../i18n/utils';
import { articleSchema, breadcrumbSchema, faqSchema, howToSchema, orgSchema } from '../../../lib/seo/schema';

export async function getStaticPaths() {
  const entries = await getCollection('guides');
  return entries.map((entry) => ({
    params: { lang: entry.data.lang, slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { lang: langParam } = Astro.params as { lang: string; slug: string };
const lang: Lang = langParam === 'zh' ? 'zh' : 'en';
const { Content } = await render(entry);

const path = `/${lang}/guides/${entry.data.slug}/`;
const crumbs = [
  { name: t(lang, 'common.home'), path: localizePath(lang, '/') },
  { name: t(lang, 'nav.guides'), path: localizePath(lang, '/guides/') },
  { name: entry.data.title, path },
];

/** Headings come straight from the MDX body, so the TOC can never drift. */
const toc = [...entry.body.matchAll(/^##\s+(.+)$/gm)].map((m, i) => ({
  id: `h-${i + 1}`,
  text: m[1].trim(),
}));

const siblings = (await getCollection('guides'))
  .filter((e) => e.data.lang === lang)
  .sort((a, b) => a.data.slug.localeCompare(b.data.slug));
const index = siblings.findIndex((e) => e.data.slug === entry.data.slug);
const next = siblings[index + 1];
const prev = siblings[index - 1];

const schema: Record<string, unknown>[] = [
  orgSchema(lang),
  articleSchema({
    lang,
    title: entry.data.title,
    description: entry.data.description,
    path,
    datePublished: entry.data.date,
    dateModified: entry.data.updated,
    author: entry.data.author,
  }),
];
if (entry.data.steps?.length) {
  schema.push(
    howToSchema({
      lang,
      name: entry.data.title,
      description: entry.data.description,
      steps: entry.data.steps,
    })
  );
}
if (entry.data.faq?.length) schema.push(faqSchema(entry.data.faq));
schema.push(breadcrumbSchema(crumbs));
---

<BaseLayout lang={lang} path={path} title={`${entry.data.title} · SecureRAG`} description={entry.data.description} type="article">
  <Breadcrumbs items={crumbs} />

  <article class="wrap layout">
    <div class="main">
      <header class="head">
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.description}</p>
        <p class="stamp">
          <time datetime={entry.data.date}>{entry.data.date}</time> · {entry.data.minutes} {t(lang, 'common.minutes')}
        </p>
      </header>

      <div class="prose">
        <Content />
      </div>

      <AdSlot lang={lang} />

      {
        entry.data.related.length > 0 && (
          <aside class="more">
            <h2>{t(lang, 'common.related')}</h2>
            <ul>
              {entry.data.related.map((href) => (
                <li>
                  <a href={href.startsWith('/en/') || href.startsWith('/zh/') ? href : localizePath(lang, href)}>
                    {href}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }

      <nav class="pager" aria-label="Guides">
        {prev && <a href={localizePath(lang, `/guides/${prev.data.slug}/`)}>← {prev.data.title}</a>}
        {next && <a class="right" href={localizePath(lang, `/guides/${next.data.slug}/`)}>{next.data.title} →</a>}
      </nav>
    </div>

    {
      toc.length > 2 && (
        <nav class="toc" aria-label={t(lang, 'common.onThisPage')}>
          <p>{t(lang, 'common.onThisPage')}</p>
          <ol>
            {toc.map((item) => (
              <li>
                <a href={`#${item.id}`}>{item.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </article>

  <JsonLd data={schema} />
</BaseLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 56px;
    align-items: start;
    padding-top: 22px;
  }
  .main {
    min-width: 0;
  }
  h1 {
    font-size: clamp(28px, 3.6vw, 42px);
    letter-spacing: -.03em;
    max-width: 24ch;
  }
  .lede {
    margin-top: 16px;
    font-size: 17px;
    line-height: 1.72;
    color: var(--muted);
    max-width: 66ch;
  }
  .stamp {
    margin-top: 14px;
    font-size: 13px;
    color: var(--muted-2);
    font-family: var(--font-mono);
  }
  .prose {
    margin-top: 8px;
  }
  .more {
    margin-top: 42px;
    border-top: 1px solid var(--line);
    padding-top: 22px;
  }
  .more h2 {
    font-size: 15px;
    margin-bottom: 12px;
  }
  .more ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .more a {
    display: inline-block;
    font-size: 14px;
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 999px;
    padding: 8px 15px;
  }
  .pager {
    display: flex;
    gap: 16px;
    justify-content: space-between;
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    font-weight: 600;
    color: var(--blue-d);
  }
  .pager .right {
    margin-left: auto;
    text-align: right;
  }
  .toc {
    position: sticky;
    top: 88px;
    font-size: 13.5px;
  }
  .toc p {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin-bottom: 12px;
  }
  .toc ol {
    border-left: 1px solid var(--line);
    padding-left: 14px;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .toc a {
    color: var(--muted);
  }
  @media (max-width: 1020px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .toc {
      display: none;
    }
  }
</style>
