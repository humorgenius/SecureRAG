---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../i18n/utils';

const lang: Lang = 'en';
const title = '404 — page not found · SecureRAG';
const description = 'That page does not exist. Head back to the SecureRAG homepage to chat with your documents locally, or open the tool.';
---

<BaseLayout lang={lang} path="/404/" title={title} description={description} noindex={true} noAds>
  <section class="wrap" style="padding:80px 0 40px">
    <p class="eyebrow">404</p>
    <h1 class="h2" style="margin-top:14px">Page not found</h1>
    <p class="lede" style="margin-top:14px">这个页面不存在。The page you asked for does not exist.</p>
    <p style="margin-top:26px;display:flex;gap:12px;flex-wrap:wrap">
      <a class="btn btn-blue" href="/en/">English homepage</a>
      <a class="btn btn-white" href="/zh/">中文首页</a>
    </p>
  </section>
</BaseLayout>
